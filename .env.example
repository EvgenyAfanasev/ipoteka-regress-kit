# =============================================================================
# Шаблон профиля для генератора досудебной претензии (scripts/pretenziya.py)
#
# Как пользоваться:
#   1. Скопируйте этот файл в .env:   cp .env.example .env
#      (или создайте автоматически:   .venv/bin/python scripts/pretenziya.py --init)
#   2. Заполните значения справа от знака «=».
#   3. Пустые поля скрипт спросит интерактивно при запуске.
#   4. Заполненные поля показываются как умолчание: Enter — принять,
#      ручной ввод — переопределить (удобно для разовых изменений).
#
# Формат значений:
#   - Кавычки не нужны:      SENDER_NAME=Иванов Иван Иванович
#   - Даты: только ДД.ММ.ГГГГ, например 05.03.2025
#   - Суммы: число, точка или запятая — 38500 или 38500.50
#   - Кириллица и пробелы в значениях разрешены
#   - Строки, начинающиеся с «#», — комментарии, скриптом не читаются
#
# .env содержит персональные данные и добавлен в .gitignore — не коммитьте.
# Этот файл (.env.example) — наоборот, коммитится как документация.
# =============================================================================

# --- Отправитель (вы) --------------------------------------------------------
# Ваше ФИО полностью, как в паспорте.
SENDER_NAME=
# Адрес вашей регистрации с индексом: г. Москва, ул. Ленина, д. 1, кв. 2, 101000
SENDER_ADDRESS=
# Ваш телефон в любом формате: +7 900 123-45-67
SENDER_PHONE=

# --- Получатель (бывшая супруга) ----------------------------------------------
# Её ФИО полностью, как в паспорте.
RECIPIENT_NAME=
# Адрес её регистрации с индексом — именно туда отправляется заказное письмо.
RECIPIENT_ADDRESS=

# --- Брак ----------------------------------------------------------------------
# Дата заключения брака (ДД.ММ.ГГГГ).
MARRIAGE_DATE=
# Серия и номер свидетельства о заключении брака, например: I-МЮ 123456
MARRIAGE_CERT=
# Дата расторжения брака (ДД.ММ.ГГГГ).
DIVORCE_DATE=
# Свидетельство о расторжении брака (серия, номер) ИЛИ — если развод через
# суд — суд и дата решения: Замоскворецкий районный суд, решение от 20.02.2026
DIVORCE_CERT=

# --- Кредитный договор -----------------------------------------------------------
# Полное наименование банка, как в договоре: ПАО «Альфа-Банк»
BANK_NAME=
# Номер кредитного договора, например: 987-К/2020
CONTRACT_NUM=
# Дата кредитного договора (ДД.ММ.ГГГГ).
CONTRACT_DATE=
# Номер вашего счёта (20 цифр), с которого вносите платежи по ипотеке.
SENDER_ACCOUNT=
# Адрес заложенной квартиры полностью, как в выписке ЕГРН.
APARTMENT_ADDRESS=
# Дата первого платежа, который она не возместила (ДД.ММ.ГГГГ).
UNPAID_FROM=

# --- Реквизиты для возврата денег --------------------------------------------------
# Банк, куда вы просите перевести возмещение: АО «Тинькофф Банк»
REFUND_BANK=
# Номер вашего счёта для получения денег (20 цифр).
REFUND_ACCOUNT=

# --- Прочее -------------------------------------------------------------------------
# Дата претензии (ДД.ММ.ГГГГ). Пусто = подставится сегодняшняя дата при запуске.
DOC_DATE=
# Срок ответа на претензию в днях (целое число больше нуля). По умолчанию 30.
REPLY_DAYS=30

# --- Платежи после развода ------------------------------------------------------------
# Внесённые вами единолично платежи по кредиту.
# Формат: дата:сумма; дата:сумма; ... (дата ДД.ММ.ГГГГ, сумма с точкой или запятой)
# Некорректные записи пропускаются с предупреждением при запуске.
# Пример:
# PAYMENTS=05.05.2026:38500; 05.06.2026:38500.50; 05.07.2026:38500
#
# Удобно вести цепочкой: каждый месяц дописывайте платёж в конец строки,
# а свежие при генерации претензии добавляйте интерактивно.
PAYMENTS=

# --- Исковое заявление (scripts/isk.py) -------------------------------------
# Наименование суда в дательном/предложном падеже:
# «Мировому судье судебного участка № 5 по г. Москве»
# или «В Замоскворецкий районный суд г. Москвы». Подсказка по подсудности:
# цена иска до 50 000 ₽ — мировой судья (п. 4 ч. 1 ст. 23 ГПК), выше — районный
# суд (порог 100 000 ₽ — только для потребительских споров).
COURT_NAME=
# Ваша дата рождения (ДД.ММ.ГГГГ) — обязательный реквизит истца (ч. 2 ст. 131 ГПК).
PLAINTIFF_BIRTH_DATE=
# Ваш паспорт полностью: серия, номер, кем и когда выдан.
PLAINTIFF_PASSPORT=
# Дата рождения ответчика (ДД.ММ.ГГГГ); пусто — неизвестна.
DEFENDANT_BIRTH_DATE=
# Паспорт/ИНН/СНИЛС ответчика; пусто — неизвестны (суд запросит отдельно).
DEFENDANT_IDENTIFIER=
# Дата отправки претензии заказным письмом (ДД.ММ.ГГГГ).
CLAIM_SENT_DATE=
# Трек-номер почтового отправления (РПО), например 10100012345678.
CLAIM_TRACK=
# Дата вручения претензии (ДД.ММ.ГГГГ); пусто — не вручена/неизвестно.
CLAIM_DELIVERED_DATE=
# Результат претензии: 1 — без ответа, 2 — отказ платить.
CLAIM_RESULT=1
